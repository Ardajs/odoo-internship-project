<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_internship_communication_center_wizard_form" model="ir.ui.view">
        <field name="name">internship.communication.center.wizard.form</field>
        <field name="model">internship.communication.center.wizard</field>
        <field name="arch" type="xml">
            <form string="Communication Center">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="communication_type"/>
                    <field name="recipient_name"/>
                    <field name="recipient_email"/>
                    <field name="subject_preview"/>
                    <field name="delivery_state"/>
                    <field name="last_communication_date" invisible="not already_sent"/>
                    <field name="already_sent" invisible="1"/>
                    <field name="can_send" invisible="1"/>
                    <field name="preview_error" invisible="not preview_error"/>
                </group>
                <notebook>
                    <page string="Message Preview">
                        <field name="body_preview" widget="html" readonly="1"/>
                    </page>
                    <page string="Manual Communication History">
                        <field name="history_preview" widget="html" readonly="1"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_refresh_preview" type="object" string="Refresh Preview" class="btn-secondary"/>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            invisible="not can_send or already_sent"
                            confirm="Queue this approved communication for sending?"/>
                    <button name="action_send_again" type="object" string="Send Again" class="btn-primary"
                            invisible="not can_send or not already_sent"
                            confirm="This communication was already queued. Send it again?"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data noupdate="1">
        <record id="ir_cron_pending_review_reminders" model="ir.cron">
            <field name="name">Internship: Pending Review Reminders</field>
            <field name="model_id" ref="model_internship_daily_entry"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_pending_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_missing_entry_reminders" model="ir.cron">
            <field name="name">Internship: Missing Entry Reminders</field>
            <field name="model_id" ref="model_internship_program"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_missing_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_ending_soon_reminders" model="ir.cron">
            <field name="name">Internship: Ending Soon Reminders</field>
            <field name="model_id" ref="model_internship_program"/>
            <field name="state">code</field>
            <field name="code">
                model._cron_remind_programs_ending_soon(days=7)
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>

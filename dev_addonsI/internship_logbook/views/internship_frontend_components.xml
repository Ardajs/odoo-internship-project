<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Reusable inline icon component for public and portal templates.

        Parameters:
        - icon: book, bell, check, dashboard, device, arrow, shield,
          user, building, or calendar
        - icon_size: numeric width/height in pixels (defaults to 24)
        - icon_class: optional additional CSS classes
        - icon_label: optional accessible label; decorative icons are hidden
          from assistive technology by default
    -->
    <template id="internship_saas_icon" name="Internship SaaS Icon">
        <t t-set="resolved_icon_size" t-value="icon_size or 24"/>
        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.8"
             focusable="false"
             t-att-width="resolved_icon_size"
             t-att-height="resolved_icon_size"
             t-att-class="'o_saas-icon %s' % (icon_class or '')"
             t-att-role="'img' if icon_label else None"
             t-att-aria-label="icon_label or None"
             t-att-aria-hidden="'false' if icon_label else 'true'">
            <t t-if="icon == 'book'">
                <path d="M4 4.75A2.75 2.75 0 0 1 6.75 2H11a1 1 0 0 1 1 1v17a2.5 2.5 0 0 0-2.5-2.5H4z"/>
                <path d="M20 4.75A2.75 2.75 0 0 0 17.25 2H13a1 1 0 0 0-1 1v17a2.5 2.5 0 0 1 2.5-2.5H20z"/>
            </t>
            <t t-elif="icon == 'bell'">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/>
                <path d="M10 21h4"/>
            </t>
            <t t-elif="icon == 'check'">
                <circle cx="12" cy="12" r="9"/>
                <path d="m8 12 2.5 2.5L16 9"/>
            </t>
            <t t-elif="icon == 'dashboard'">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
            </t>
            <t t-elif="icon == 'device'">
                <rect x="4" y="2.5" width="16" height="19" rx="2"/>
                <path d="M9 18h6"/>
            </t>
            <t t-elif="icon == 'arrow'">
                <path d="M5 12h14"/>
                <path d="m14 7 5 5-5 5"/>
            </t>
            <t t-elif="icon == 'shield'">
                <path d="M12 3 5 6v5c0 4.8 2.9 8.2 7 10 4.1-1.8 7-5.2 7-10V6z"/>
                <path d="m9 12 2 2 4-4"/>
            </t>
            <t t-elif="icon == 'user'">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21a8 8 0 0 1 16 0"/>
            </t>
            <t t-elif="icon == 'building'">
                <path d="M4 21V5l8-3 8 3v16"/>
                <path d="M2 21h20M8 8h1m6 0h1M8 12h1m6 0h1M8 16h1m6 0h1"/>
            </t>
            <t t-elif="icon == 'calendar'">
                <rect x="3" y="5" width="18" height="16" rx="2"/>
                <path d="M16 3v4M8 3v4M3 10h18"/>
            </t>
            <t t-else="">
                <circle cx="12" cy="12" r="9"/>
            </t>
        </svg>
    </template>
</odoo>

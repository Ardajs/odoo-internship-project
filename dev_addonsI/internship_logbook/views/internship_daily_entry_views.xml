<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Daily Entry List View -->
    <record id="view_internship_daily_entry_list" model="ir.ui.view">
        <field name="name">internship.daily.entry.list</field>
        <field name="model">internship.daily.entry</field>
        <field name="arch" type="xml">
            <list
                string="Daily Entries"
                decoration-info="state == 'draft'"
                decoration-warning="state == 'submitted'"
                decoration-danger="state == 'revision'"
                decoration-success="state in ('approved', 'completed')">

                <field name="entry_date"/>
                <field name="day_number"/>
                <field name="title"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="workflow_mode" optional="show"/>
                <field name="supervisor_id" optional="hide"/>
                <field name="company_name" optional="hide"/>
                <field name="student_university" optional="hide"/>
                <field name="work_hours"/>
                <field name="state" widget="badge"/>

            </list>
        </field>
    </record>


    <!-- Daily Entry Form View -->
    <record id="view_internship_daily_entry_form" model="ir.ui.view">
        <field name="name">internship.daily.entry.form</field>
        <field name="model">internship.daily.entry</field>
        <field name="arch" type="xml">
            <form string="Daily Internship Entry">

                <header>
                    <field name="workflow_mode" invisible="1"/>
                    <field name="program_state" invisible="1"/>

                    <button
                        name="action_submit"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        groups="internship_logbook.group_internship_intern,internship_logbook.group_internship_manager"
                        invisible="workflow_mode != 'supervised' or state not in ('draft', 'revision')"/>

                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="internship_logbook.group_internship_supervisor,internship_logbook.group_internship_manager"
                        invisible="workflow_mode != 'supervised' or state != 'submitted'"/>

                    <button
                        name="action_request_revision"
                        string="Request Revision"
                        type="object"
                        groups="internship_logbook.group_internship_supervisor,internship_logbook.group_internship_manager"
                        invisible="workflow_mode != 'supervised' or state != 'submitted'"/>

                    <button
                        name="action_review_next"
                        string="Review Next"
                        type="object"
                        groups="internship_logbook.group_internship_supervisor,internship_logbook.group_internship_manager"
                        invisible="workflow_mode != 'supervised' or state != 'submitted'"/>

                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="workflow_mode != 'supervised' or state != 'revision'"/>

                    <button
                        name="action_complete"
                        string="Complete"
                        type="object"
                        class="btn-primary"
                        groups="internship_logbook.group_internship_intern,internship_logbook.group_internship_manager"
                        invisible="workflow_mode != 'independent' or state != 'draft' or program_state != 'active'"/>

                    <button
                        name="action_reopen"
                        string="Reopen"
                        type="object"
                        groups="internship_logbook.group_internship_intern,internship_logbook.group_internship_manager"
                        invisible="workflow_mode != 'independent' or state != 'completed' or program_state != 'active'"/>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,revision,approved"
                        invisible="workflow_mode == 'independent'"/>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,completed"
                        invisible="workflow_mode != 'independent'"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_student"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user"
                                groups="internship_logbook.group_internship_supervisor,internship_logbook.group_internship_manager">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Open Student</span>
                            </div>
                        </button>
                        <button name="action_open_program"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-briefcase"
                                groups="internship_logbook.group_internship_supervisor,internship_logbook.group_internship_manager">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Open Program</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="title"/>
                        <h1>
                            <field
                                name="title"
                                placeholder="Example: Creating an Odoo model"
                                readonly="state not in ('draft', 'revision')"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Internship Information">

                            <field
                                name="program_id"
                                readonly="state not in ('draft', 'revision')"/>

                            <field name="student_id" readonly="1"/>

                            <field
                                name="supervisor_id"
                                readonly="1"
                                invisible="workflow_mode == 'independent'"/>

                            <field name="company_name" readonly="1"/>

                            <field name="program_department" readonly="1"/>

                        </group>

                        <group string="Daily Information">

                            <field
                                name="entry_date"
                                readonly="state not in ('draft', 'revision')"/>

                            <field name="day_number" readonly="1"/>

                            <field
                                name="work_hours"
                                readonly="state not in ('draft', 'revision')"/>

                            <field name="active"/>

                        </group>
                    </group>

                    <group string="Work Details">

                        <field
                            name="technologies"
                            placeholder="Python, Odoo, PostgreSQL, XML..."
                            readonly="state not in ('draft', 'revision')"/>

                        <field
                            name="work_description"
                            placeholder="Describe the work completed during the day..."
                            readonly="state not in ('draft', 'revision')"/>

                    </group>

                    <group string="Learning and Problems">

                        <field
                            name="learned_topics"
                            placeholder="What did you learn today?"
                            readonly="state not in ('draft', 'revision')"/>

                        <field
                            name="challenges"
                            placeholder="Describe encountered problems and their solutions..."
                            readonly="state not in ('draft', 'revision')"/>

                    </group>

                    <group
                        string="Supervisor Evaluation"
                        invisible="workflow_mode == 'independent' or state == 'draft'">

                        <div class="alert alert-info" role="alert"
                             invisible="state != 'submitted'">
                            Add a clear review comment before requesting a revision.
                        </div>

                        <field
                            name="supervisor_comment"
                            readonly="state != 'submitted'"
                            placeholder="Supervisor evaluation or revision explanation..."/>

                    </group>

                </sheet>

                <chatter>
                    <field
                        name="message_follower_ids"
                        widget="mail_followers"/>

                    <field
                        name="activity_ids"
                        widget="mail_activity"/>

                    <field
                        name="message_ids"
                        widget="mail_thread"/>
                </chatter>


            </form>
        </field>
    </record>


    <!-- Daily Entry Search View -->
    <record id="view_internship_daily_entry_search" model="ir.ui.view">
        <field name="name">internship.daily.entry.search</field>
        <field name="model">internship.daily.entry</field>
        <field name="arch" type="xml">
            <search string="Search Daily Entries">

                <field name="title"/>
                <field name="program_id"/>
                <field name="student_id"/>
                <field name="workflow_mode"/>
                <field name="supervisor_id"/>
                <field name="company_name"/>
                <field name="student_university"/>
                <field name="entry_date"/>
                <field name="technologies"/>

                <separator/>

                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"/>

                <filter
                    name="filter_submitted"
                    string="Submitted"
                    domain="[('state', '=', 'submitted')]"/>

                <filter
                    name="filter_revision"
                    string="Revision Requested"
                    domain="[('state', '=', 'revision')]"/>

                <filter
                    name="filter_approved"
                    string="Approved"
                    domain="[('state', '=', 'approved')]"/>

                <filter
                    name="filter_completed"
                    string="Completed"
                    domain="[('state', '=', 'completed')]"/>

                <separator/>

                <filter
                    name="filter_my_entries"
                    string="My Supervised Entries"
                    domain="[('supervisor_id', '=', uid)]"/>

                <filter
                    name="filter_my_students"
                    string="My Students"
                    domain="[('workflow_mode', '=', 'supervised'), ('supervisor_id', '=', uid)]"/>

                <separator/>

                <filter
                    name="filter_pending_review"
                    string="Pending Review"
                    domain="[('workflow_mode', '=', 'supervised'), ('state', '=', 'submitted')]"/>

                <filter
                    name="filter_submitted_today"
                    string="Submitted Today"
                    domain="[('state', '=', 'submitted'), ('write_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('write_date', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>

                <filter
                    name="filter_this_week"
                    string="This Week"
                    domain="[('entry_date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('entry_date', '&lt;=', (context_today() + relativedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>

                <filter
                    name="filter_last_30_days"
                    string="Last 30 Days"
                    domain="[('entry_date', '&gt;=', (context_today() - relativedelta(days=29)).strftime('%Y-%m-%d')), ('entry_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>

                <filter
                    name="filter_current_month"
                    string="Current Month"
                    domain="[('entry_date', '&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d')), ('entry_date', '&lt;', (context_today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>

                <filter
                    name="filter_previous_month"
                    string="Previous Month"
                    domain="[('entry_date', '&gt;=', (context_today().replace(day=1) - relativedelta(months=1)).strftime('%Y-%m-%d')), ('entry_date', '&lt;', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>

                <filter
                    name="filter_current_year"
                    string="Current Year"
                    domain="[('entry_date', '&gt;=', context_today().replace(month=1, day=1).strftime('%Y-%m-%d')), ('entry_date', '&lt;', (context_today().replace(month=1, day=1) + relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>

                <filter
                    name="filter_high_hours"
                    string="High Hour Entries"
                    domain="[('work_hours', '&gt;', 8)]"/>

                <filter
                    name="filter_low_hours"
                    string="Low Hour Entries"
                    domain="[('work_hours', '&lt;', 8)]"/>

                <filter
                    name="filter_missing_days"
                    string="Missing Days"
                    domain="[('program_id.has_missing_days', '=', True)]"/>

                <filter
                    name="filter_ending_soon"
                    string="Ending Soon"
                    domain="[('program_id.state', '=', 'active'), ('program_id.end_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('program_id.end_date', '&lt;=', (context_today() + relativedelta(days=14)).strftime('%Y-%m-%d'))]"/>

                <separator/>

                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"/>

                <group>

                    <filter
                        name="group_by_student"
                        string="Student"
                        context="{'group_by': 'student_id'}"/>

                    <filter
                        name="group_by_program"
                        string="Internship Program"
                        context="{'group_by': 'program_id'}"/>

                    <filter
                        name="group_by_supervisor"
                        string="Supervisor"
                        context="{'group_by': 'supervisor_id'}"/>

                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_name'}"/>

                    <filter
                        name="group_by_university"
                        string="University"
                        context="{'group_by': 'student_university'}"/>

                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"/>

                    <filter
                        name="group_by_entry_month"
                        string="Entry Month"
                        context="{'group_by': 'entry_date:month'}"/>

                </group>

            </search>
        </field>
    </record>

    <record id="view_internship_supervisor_review_queue_list"
            model="ir.ui.view">
        <field name="name">internship.daily.entry.supervisor.review.list</field>
        <field name="model">internship.daily.entry</field>
        <field name="arch" type="xml">
            <list string="Supervisor Review Queue"
                  default_order="write_date desc, entry_date desc, id desc"
                  decoration-warning="state == 'submitted'">
                <field name="write_date"
                       string="Submitted / Updated"
                       optional="show"/>
                <field name="entry_date"/>
                <field name="title"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="company_name" optional="show"/>
                <field name="student_university" optional="hide"/>
                <field name="work_hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_internship_daily_entry_pivot" model="ir.ui.view">
        <field name="name">internship.daily.entry.pivot</field>
        <field name="model">internship.daily.entry</field>
        <field name="arch" type="xml">
            <pivot string="Daily Entry Analysis">
                <field name="student_id" type="row"/>
                <field name="program_id" type="row"/>
                <field name="state" type="col"/>
                <field name="work_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_internship_daily_entry_graph" model="ir.ui.view">
        <field name="name">internship.daily.entry.graph</field>
        <field name="model">internship.daily.entry</field>
        <field name="arch" type="xml">
            <graph string="Daily Entry Analysis" type="bar" stacked="1">
                <field name="entry_date" interval="month"/>
                <field name="state"/>
                <field name="work_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_internship_supervisor_review_queue"
            model="ir.actions.act_window">
        <field name="name">Review Queue</field>
        <field name="res_model">internship.daily.entry</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="view_id"
               ref="view_internship_supervisor_review_queue_list"/>
        <field name="search_view_id"
               ref="view_internship_daily_entry_search"/>
        <field name="domain">
            [('workflow_mode', '=', 'supervised'), ('state', '=', 'submitted')]
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No daily entries are waiting for review.
            </p>
        </field>
    </record>


    <!-- Daily Entry Window Action -->
    <record id="action_internship_daily_entry" model="ir.actions.act_window">
        <field name="name">Daily Entries</field>
        <field name="res_model">internship.daily.entry</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field
            name="search_view_id"
            ref="view_internship_daily_entry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first daily internship entry
            </p>
            <p>
                Record daily activities, technologies, learning outcomes
                and encountered problems.
            </p>
        </field>
    </record>

</odoo>
